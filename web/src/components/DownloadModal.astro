---
// The download "shutterbox": a hazard-shuttered overlay. One theme dropdown (pre-populated with
// whatever you were just previewing) + a single direct-download button for that theme's zip on the
// current release (hard-coded in src/lib/site.ts). The 4-step recipe + an "all releases" link round
// it out.
import { THEMES, DEFAULT_THEME, themeBySlug } from "../lib/themes";
import { RELEASES_URL, CURRENT_VERSION, zipUrl } from "../lib/site";

const active = themeBySlug(DEFAULT_THEME)!;

const STEPS = [
  { n: 1, t: "Grab a pack", d: "Pick a theme and download its ZIP." },
  { n: 2, t: "Unzip it", d: "You'll get svg/, png/, and a preview.html." },
  { n: 3, t: "Browse", d: "Open preview.html locally to see everything." },
  { n: 4, t: "Drag & drop", d: "Drop the SVGs or PNGs into Excalidraw, draw.io, anywhere." },
];
---

<div class="shutter" id="download-modal" hidden aria-hidden="true">
  <div class="shutter-backdrop" data-close></div>
  <div class="shutter-panel panel" role="dialog" aria-modal="true" aria-labelledby="dl-title">
    <div class="hazard shutter-top" aria-hidden="true"></div>
    <button type="button" class="shutter-x" data-close aria-label="Close">&times;</button>

    <div class="shutter-body">
      <header class="dl-head">
        <h2 id="dl-title">Download a pack</h2>
        <p class="dl-sub">Version {CURRENT_VERSION}</p>
      </header>

      <div class="dl-picker">
        <div class="select-wrap">
          <select class="js-theme-select" aria-label="Choose a theme to download">
            {
              THEMES.map((t) => (
                <option value={t.slug} selected={t.slug === DEFAULT_THEME}>
                  {t.name}
                </option>
              ))
            }
          </select>
          <svg class="chev" viewBox="0 0 12 8" aria-hidden="true"
            ><path d="M1 1l5 5 5-5" fill="none" stroke="currentColor" stroke-width="1.6"></path></svg
          >
        </div>
        <a
          class="btn-ficsit dl-go"
          data-download-zip
          href={zipUrl(DEFAULT_THEME)}
          target="_blank"
          rel="noopener"
        >
          <svg viewBox="0 0 16 16" width="15" height="15" aria-hidden="true">
            <path
              d="M8 1v8m0 0L5 6m3 3l3-3M2 12h12"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
          Download ZIP
        </a>
      </div>
      <p class="dl-blurb" data-theme-blurb>{active.blurb}</p>

      <ol class="dl-steps">
        {
          STEPS.map((s) => (
            <li>
              <span class="dl-step-n">{s.n}</span>
              <span class="dl-step-body">
                <span class="dl-step-t">{s.t}</span>
                <span class="dl-step-d">{s.d}</span>
              </span>
            </li>
          ))
        }
      </ol>

      <p class="dl-foot">
        Looking for an older release? <a href={RELEASES_URL} target="_blank" rel="noopener"
          >All releases &rarr;</a
        >
      </p>
    </div>
  </div>
</div>

<style>
  .shutter {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: grid;
    place-items: center;
    padding: 1.25rem;
  }
  .shutter[hidden] {
    display: none;
  }
  .shutter-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(6, 6, 8, 0.72);
    backdrop-filter: blur(4px);
    animation: fade 0.2s var(--ease-out-quart);
  }
  .shutter-panel {
    position: relative;
    width: min(600px, 100%);
    max-height: 90vh;
    overflow: hidden;
    border-radius: 14px;
    animation: shutter-in 0.42s var(--ease-out-quart);
  }
  .shutter-top {
    height: 8px;
  }
  .shutter-x {
    position: absolute;
    top: 12px;
    right: 14px;
    z-index: 2;
    width: 32px;
    height: 32px;
    font-size: 1.4rem;
    line-height: 1;
    color: var(--color-ink);
    background: rgba(0, 0, 0, 0.3);
    border: 1px solid var(--color-metal);
    border-radius: 8px;
    cursor: pointer;
  }
  .shutter-x:hover {
    color: var(--color-ficsit);
    border-color: var(--color-ficsit);
  }
  .shutter-body {
    padding: clamp(1.25rem, 4vw, 2rem);
    overflow-y: auto;
    max-height: calc(90vh - 8px);
  }
  .dl-head h2 {
    font-size: 1.7rem;
    margin: 0;
  }
  .dl-sub {
    margin: 0.35rem 0 0;
    font-family: var(--font-display);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-size: 0.82rem;
    color: var(--color-ficsit);
  }

  .dl-picker {
    display: flex;
    gap: 0.75rem;
    align-items: stretch;
    margin: 1.5rem 0 0.5rem;
    flex-wrap: nowrap;
  }
  .select-wrap {
    position: relative;
    display: inline-flex;
    align-items: center;
    flex: 1 1 auto;
    min-width: 0;
  }
  .js-theme-select {
    appearance: none;
    width: 100%;
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 500;
    letter-spacing: 0.02em;
    color: var(--color-ink);
    background: var(--color-void);
    border: 1px solid var(--color-metal);
    border-radius: 8px;
    padding: 0.7rem 2.2rem 0.7rem 0.95rem;
    cursor: pointer;
  }
  .js-theme-select:hover {
    border-color: var(--color-ficsit);
  }
  .js-theme-select:focus-visible {
    outline: 2px solid var(--color-ficsit);
    outline-offset: 1px;
  }
  .chev {
    position: absolute;
    right: 0.8rem;
    width: 12px;
    height: 8px;
    color: var(--color-ficsit);
    pointer-events: none;
  }
  .dl-go {
    flex: none;
    white-space: nowrap;
  }
  .dl-blurb {
    margin: 0 0 1.5rem;
    font-size: 0.85rem;
    color: var(--color-ink-dim);
  }

  .dl-steps {
    list-style: none;
    margin: 0;
    padding: 1.25rem 0 0;
    border-top: 1px solid var(--color-metal);
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
  }
  .dl-steps li {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }
  .dl-step-n {
    flex: none;
    width: 28px;
    height: 28px;
    display: grid;
    place-items: center;
    font-family: var(--font-display);
    font-weight: 700;
    color: #1a1205;
    background: var(--color-ficsit);
    border-radius: 7px;
  }
  .dl-step-body {
    display: flex;
    flex-direction: column;
  }
  .dl-step-t {
    font-weight: 600;
    font-size: 0.9rem;
    color: var(--color-ink);
  }
  .dl-step-d {
    font-size: 0.78rem;
    color: var(--color-ink-dim);
  }
  .dl-foot {
    margin: 1.25rem 0 0;
    font-size: 0.82rem;
    color: var(--color-ink-dim);
  }
  .dl-foot a {
    color: var(--color-ficsit);
  }
  .dl-foot a:hover {
    text-decoration: underline;
  }

  @keyframes fade {
    from {
      opacity: 0;
    }
  }
  @keyframes shutter-in {
    from {
      transform: translateY(-12px) scale(0.98);
      opacity: 0;
      clip-path: inset(0 0 100% 0);
    }
    to {
      transform: none;
      opacity: 1;
      clip-path: inset(0 0 0 0);
    }
  }
  @media (max-width: 560px) {
    .dl-steps {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 420px) {
    .dl-picker {
      flex-wrap: wrap;
    }
    .dl-go {
      width: 100%;
      justify-content: center;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .shutter-panel,
    .shutter-backdrop {
      animation: none;
    }
  }
</style>
