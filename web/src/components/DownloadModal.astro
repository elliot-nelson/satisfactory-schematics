---
// The download "shutterbox": a full-screen overlay with a hazard-shutter reveal. Lists every theme
// with a direct link to its latest-release zip (filled in by the app island; falls back to the
// releases page) plus the 4-step "how to use these" recipe.
import { THEMES } from "../lib/themes";
import { LATEST_RELEASE_URL, RELEASES_URL } from "../lib/site";

const STEPS = [
  { n: 1, t: "Grab a pack", d: "Pick a theme below and download its ZIP." },
  { n: 2, t: "Unzip it", d: "You'll get svg/, png/, and a preview.html." },
  { n: 3, t: "Browse", d: "Open preview.html locally to see everything." },
  { n: 4, t: "Drag & drop", d: "Drop the SVGs or PNGs into Excalidraw, draw.io, anywhere." },
];
---

<div class="shutter" id="download-modal" hidden aria-hidden="true">
  <div class="shutter-backdrop" data-close></div>
  <div class="shutter-panel panel" role="dialog" aria-modal="true" aria-labelledby="dl-title">
    <div class="hazard shutter-top" aria-hidden="true"></div>
    <button type="button" class="shutter-x" data-close aria-label="Close">&times;</button>

    <div class="shutter-body">
      <header class="dl-head">
        <h2 id="dl-title">Download a pack</h2>
        <p class="dl-sub" id="dl-release">Fetching the latest release&hellip;</p>
      </header>

      <div class="dl-themes">
        {
          THEMES.map((t) => (
            <a
              class="dl-theme"
              data-theme-zip={t.slug}
              href={LATEST_RELEASE_URL}
              target="_blank"
              rel="noopener"
            >
              <span class="dl-theme-main">
                <span class="dl-theme-name">{t.name}</span>
                <span class="dl-theme-blurb">{t.blurb}</span>
              </span>
              <span class="dl-theme-btn">
                <span class="dl-size" data-size>ZIP</span>
                <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
                  <path
                    d="M8 1v8m0 0L5 6m3 3l3-3M2 12h12"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.6"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </span>
            </a>
          ))
        }
      </div>

      <ol class="dl-steps">
        {
          STEPS.map((s) => (
            <li>
              <span class="dl-step-n">{s.n}</span>
              <span class="dl-step-t">{s.t}</span>
              <span class="dl-step-d">{s.d}</span>
            </li>
          ))
        }
      </ol>

      <p class="dl-foot">
        Looking for older versions? <a href={RELEASES_URL} target="_blank" rel="noopener"
          >All releases &rarr;</a
        >
      </p>
    </div>
  </div>
</div>

<style>
  .shutter {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: grid;
    place-items: center;
    padding: 1.25rem;
  }
  .shutter[hidden] {
    display: none;
  }
  .shutter-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(6, 6, 8, 0.72);
    backdrop-filter: blur(4px);
    animation: fade 0.2s var(--ease-out-quart);
  }
  .shutter-panel {
    position: relative;
    width: min(680px, 100%);
    max-height: 90vh;
    overflow: hidden;
    border-radius: 14px;
    animation: shutter-in 0.42s var(--ease-out-quart);
  }
  .shutter-top {
    height: 8px;
  }
  .shutter-x {
    position: absolute;
    top: 12px;
    right: 14px;
    z-index: 2;
    width: 32px;
    height: 32px;
    font-size: 1.4rem;
    line-height: 1;
    color: var(--color-ink);
    background: rgba(0, 0, 0, 0.3);
    border: 1px solid var(--color-metal);
    border-radius: 8px;
    cursor: pointer;
  }
  .shutter-x:hover {
    color: var(--color-ficsit);
    border-color: var(--color-ficsit);
  }
  .shutter-body {
    padding: clamp(1.25rem, 4vw, 2rem);
    overflow-y: auto;
    max-height: calc(90vh - 8px);
  }
  .dl-head h2 {
    font-size: 1.7rem;
    margin: 0;
  }
  .dl-sub {
    margin: 0.35rem 0 0;
    font-size: 0.85rem;
    color: var(--color-ink-dim);
  }
  .dl-themes {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    margin: 1.5rem 0;
  }
  .dl-theme {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.85rem 1rem;
    border-radius: 10px;
    background: var(--color-void);
    border: 1px solid var(--color-metal);
    transition:
      border-color 0.12s var(--ease-out-quart),
      transform 0.12s var(--ease-out-quart);
  }
  .dl-theme:hover {
    border-color: var(--color-ficsit);
    transform: translateX(2px);
  }
  .dl-theme-main {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    min-width: 0;
  }
  .dl-theme-name {
    font-family: var(--font-display);
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--color-ink);
  }
  .dl-theme-blurb {
    font-size: 0.8rem;
    color: var(--color-ink-dim);
  }
  .dl-theme-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    flex: none;
    color: var(--color-ficsit);
    font-family: var(--font-display);
    font-size: 0.8rem;
    letter-spacing: 0.04em;
  }
  .dl-size {
    color: var(--color-ink-dim);
  }
  .dl-steps {
    list-style: none;
    margin: 0;
    padding: 1.25rem 0 0;
    border-top: 1px solid var(--color-metal);
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
  }
  .dl-steps li {
    display: grid;
    grid-template-columns: auto 1fr;
    grid-template-rows: auto auto;
    column-gap: 0.6rem;
    align-items: center;
  }
  .dl-step-n {
    grid-row: 1 / 3;
    width: 28px;
    height: 28px;
    display: grid;
    place-items: center;
    font-family: var(--font-display);
    font-weight: 700;
    color: #1a1205;
    background: var(--color-ficsit);
    border-radius: 7px;
  }
  .dl-step-t {
    font-weight: 600;
    font-size: 0.9rem;
    color: var(--color-ink);
  }
  .dl-step-d {
    grid-column: 2;
    font-size: 0.78rem;
    color: var(--color-ink-dim);
  }
  .dl-foot {
    margin: 1.25rem 0 0;
    font-size: 0.82rem;
    color: var(--color-ink-dim);
  }
  .dl-foot a {
    color: var(--color-ficsit);
  }
  .dl-foot a:hover {
    text-decoration: underline;
  }

  @keyframes fade {
    from {
      opacity: 0;
    }
  }
  @keyframes shutter-in {
    from {
      transform: translateY(-12px) scale(0.98);
      opacity: 0;
      clip-path: inset(0 0 100% 0);
    }
    to {
      transform: none;
      opacity: 1;
      clip-path: inset(0 0 0 0);
    }
  }
  @media (max-width: 560px) {
    .dl-steps {
      grid-template-columns: 1fr;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .shutter-panel,
    .shutter-backdrop {
      animation: none;
    }
  }
</style>
