---
// FICSIT-orange take on the classic tholman github-corner. Fixed top-right; the octocat arm waves
// on hover. Purely decorative link to the repo.
import { REPO_URL } from "../lib/site";
---

<a
  href={REPO_URL}
  target="_blank"
  rel="noopener"
  class="gh-corner"
  aria-label="View source on GitHub"
>
  <svg width="80" height="80" viewBox="0 0 250 250" aria-hidden="true">
    <path d="M0,0 L115,115 L130,115 L142,142 L250,250 L250,0 Z"></path>
    <path
      d="M128.3,109.0 C113.8,99.7 119.0,89.6 119.0,89.6 C122.0,82.7 120.5,78.6 120.5,78.6 C119.2,72.0 123.4,76.3 123.4,76.3 C127.3,80.9 125.5,87.3 125.5,87.3 C122.9,97.6 130.6,101.9 134.4,103.2"
      fill="currentColor"
      style="transform-origin: 130px 106px;"
      class="gh-arm"></path>
    <path
      d="M115.0,115.0 C114.9,115.1 118.7,116.5 119.8,115.4 L133.7,101.6 C136.9,99.2 139.9,98.4 142.2,98.6 C133.8,88.0 127.5,74.4 143.8,58.0 C148.5,53.4 154.0,51.2 159.7,51.0 C160.3,49.4 163.2,43.6 171.4,40.1 C171.4,40.1 176.1,42.5 177.7,56.0 C182.0,60.4 184.8,65.5 185.1,71.5 C190.0,73.6 194.3,77.2 194.3,77.2 L185.3,77.6 C185.4,78.4 185.3,79.1 185.1,79.8 C176.2,90.9 165.7,90.8 156.5,87.0 C156.6,89.3 155.8,92.3 153.4,94.7 L139.5,108.5 C138.4,109.6 139.8,113.4 139.9,113.3 Z"
      fill="currentColor"
      class="gh-octo"></path>
  </svg>
</a>

<style>
  .gh-corner {
    position: fixed;
    top: 0;
    right: 0;
    z-index: 60;
    color: var(--color-ficsit);
    line-height: 0;
  }
  .gh-corner svg {
    fill: var(--color-ficsit);
    color: var(--color-void);
  }
  .gh-corner:hover svg {
    fill: var(--color-ficsit-deep);
  }
  .gh-arm {
    transform-origin: 130px 106px;
  }
  .gh-corner:hover .gh-arm {
    animation: gh-wave 560ms ease-in-out;
  }
  @keyframes gh-wave {
    0%,
    100% {
      transform: rotate(0);
    }
    20%,
    60% {
      transform: rotate(-22deg);
    }
    40%,
    80% {
      transform: rotate(10deg);
    }
  }
  @media (max-width: 640px) {
    .gh-corner svg {
      width: 64px;
      height: 64px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .gh-corner:hover .gh-arm {
      animation: none;
    }
  }
</style>
