---
// Sticky title bar styled like FICSIT caution tape (yellow/gray diagonal hazard stripes). Brand +
// nav ride on dark "control-panel" plates so they stay legible on the busy background. The GitHub
// corner owns the top-right, so we keep clear of it.
---

<header class="site-header">
  <div class="hazard-bg" aria-hidden="true"></div>
  <a href="#top" class="brand plate">
    <span class="brand-badge"></span>
    <span class="brand-text">
      <span class="brand-1">SATISFACTORY</span>
      <span class="brand-2">SCHEMATICS</span>
    </span>
  </a>
  <nav class="site-nav plate">
    <a href="#preview">Preview</a>
    <span class="nav-sep" aria-hidden="true"></span>
    <button type="button" data-download class="nav-download">Download</button>
  </nav>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.6rem clamp(1rem, 4vw, 2.5rem);
    padding-right: 96px; /* keep clear of the 80px github corner */
    border-bottom: 2px solid #0a0a0b;
    box-shadow: 0 6px 18px rgba(0, 0, 0, 0.45);
    isolation: isolate;
  }
  /* the caution-tape background, dimmed a touch so the plates pop */
  .hazard-bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    background-image: repeating-linear-gradient(
      -45deg,
      #e7b528 0,
      #e7b528 15px,
      #26262b 15px,
      #26262b 30px
    );
  }
  .hazard-bg::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(0, 0, 0, 0.12), rgba(0, 0, 0, 0.34));
  }

  /* dark control-panel plate that brand + nav sit on */
  .plate {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.4rem 0.8rem;
    background: color-mix(in srgb, var(--color-void) 92%, transparent);
    border: 1px solid #000;
    border-radius: 9px;
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.05),
      0 2px 8px rgba(0, 0, 0, 0.5);
  }

  .brand-badge {
    width: 20px;
    height: 20px;
    border-radius: 5px;
    background: var(--color-ficsit);
    border: 1px solid var(--color-ficsit-deep);
    box-shadow: 0 0 12px rgba(250, 149, 73, 0.5);
    flex: none;
  }
  .brand-text {
    display: flex;
    flex-direction: column;
    line-height: 0.98;
    font-family: var(--font-display);
    letter-spacing: 0.14em;
  }
  .brand-1 {
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--color-ink);
  }
  .brand-2 {
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--color-ficsit);
  }

  .site-nav {
    gap: 0.85rem;
  }
  .site-nav a,
  .nav-download {
    font-family: var(--font-display);
    font-size: 0.82rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .site-nav a {
    color: var(--color-ink);
    transition: color 0.12s var(--ease-out-quart);
  }
  .site-nav a:hover {
    color: var(--color-ficsit);
  }
  .nav-sep {
    width: 1px;
    height: 16px;
    background: var(--color-metal);
  }
  .nav-download {
    color: var(--color-ficsit);
    background: transparent;
    border: none;
    padding: 0;
    cursor: pointer;
    transition: color 0.12s var(--ease-out-quart);
  }
  .nav-download:hover {
    color: var(--color-ficsit-glow);
  }

  @media (max-width: 640px) {
    .brand-text {
      display: none;
    }
    .brand {
      padding: 0.4rem 0.55rem;
    }
  }
</style>
