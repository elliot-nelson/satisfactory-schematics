---
// Footer: the brand mark, repo links, and the all-important "not official" disclaimer.
import { REPO_URL, RELEASES_URL } from "../lib/site";
---

<footer class="site-footer">
  <div class="hazard-rail"></div>
  <div class="footer-inner">
    <div class="footer-top">
      <div class="footer-brand">
        <span class="footer-badge"></span>
        <span>Satisfactory Schematics</span>
      </div>
      <ul class="links">
        <li><a href={REPO_URL} target="_blank" rel="noopener">GitHub repo &rarr;</a></li>
        <li><a href={RELEASES_URL} target="_blank" rel="noopener">All Releases &rarr;</a></li>
        <li>
          <a href={`${REPO_URL}/blob/main/DEVELOPER_GUIDE.md`} target="_blank" rel="noopener"
            >Developer guide &rarr;</a
          >
        </li>
      </ul>
    </div>

    <p class="disclaimer">
      This project is completely independent and is not endorsed by, sponsored by, or affiliated
      with the game Satisfactory or its developers, Coffee Stain Studios. All game titles, logos,
      and assets belong to their respective copyright and trademark owners.
    </p>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: 3rem;
    border-top: 1px solid var(--color-metal);
    background: linear-gradient(180deg, transparent, rgba(0, 0, 0, 0.35));
  }
  .footer-inner {
    max-width: 72rem;
    margin: 0 auto;
    padding: 2.5rem clamp(1rem, 4vw, 2.5rem) 2.5rem;
  }
  .footer-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    flex-wrap: wrap;
  }
  .footer-brand {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    font-family: var(--font-display);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-size: 0.92rem;
    color: var(--color-ink);
  }
  .footer-badge {
    width: 18px;
    height: 18px;
    border-radius: 5px;
    background: var(--color-ficsit);
    border: 1px solid var(--color-ficsit-deep);
    flex: none;
  }
  .links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    font-size: 0.88rem;
    color: var(--color-ink-dim);
  }
  .links a:hover {
    color: var(--color-ficsit);
  }
  .disclaimer {
    margin: 2rem 0 0;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-metal);
    font-size: 0.76rem;
    line-height: 1.6;
    color: var(--color-ink-dim);
    max-width: 60rem;
  }
</style>
