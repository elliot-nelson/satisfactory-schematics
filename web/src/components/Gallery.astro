---
// The preview gallery, rendered at build time from the (theme-independent) manifest. Every card's
// <img> carries data-file; the app island rewrites its src prefix when the theme changes.
import ThemePicker from "./ThemePicker.astro";
import { categories, buildings, svgFile } from "../lib/manifest";
import { DEFAULT_THEME } from "../lib/themes";

function dims(v: { width_px: number | null; height_px: number | null }): string {
  return v.width_px && v.height_px ? `${v.width_px}\u00d7${v.height_px} px` : "";
}
function bboxText(b: { bbox_m: { x: number; y: number; z: number } | null }): string {
  const bb = b.bbox_m;
  return bb ? `${bb.x.toFixed(1)} \u00d7 ${bb.y.toFixed(1)} \u00d7 ${bb.z.toFixed(1)} m` : "";
}
---

<section id="preview" class="preview">
  <div class="preview-head">
    <span class="kicker">The catalog</span>
    <h2>Every building, five ways</h2>
    <p>
      True-to-scale orthographic views &mdash; top, front, back, left, right. Pick a theme and the
      whole board re-skins instantly.
    </p>
  </div>

  <ThemePicker />

  <div class="gallery">
    {
      categories.map((cat) => (
        <section class="cat" id={`cat-${cat.id}`}>
          <header class="cat-h">
            <h3>{cat.name}</h3>
            <p>{cat.blurb}</p>
          </header>
          {cat.builds.map((stem) => {
            const b = buildings[stem];
            if (!b) return null;
            const bb = bboxText(b);
            return (
              <article class="build" id={`b-${stem}`}>
                <div class="build-h">
                  <h4>{b.label}</h4>
                  <span class="build-meta">
                    {b.views.length} views{bb ? ` \u00b7 ${bb}` : ""}
                  </span>
                </div>
                <div class="views">
                  {b.views.map((v) => {
                    const file = svgFile(v);
                    return (
                      <figure class="card">
                        <button
                          type="button"
                          class="stage paper"
                          data-zoom
                          aria-label={`Zoom ${b.label} ${v.view} view`}
                        >
                          <img
                            loading="lazy"
                            data-file={file}
                            src={`/themes/${DEFAULT_THEME}/svg/${file}`}
                            alt={`${b.label} ${v.view} view`}
                            width={v.width_px ?? undefined}
                            height={v.height_px ?? undefined}
                          />
                        </button>
                        <figcaption>
                          <span class="v">{v.view}</span>
                          <span class="d">{dims(v)}</span>
                        </figcaption>
                      </figure>
                    );
                  })}
                </div>
              </article>
            );
          })}
        </section>
      ))
    }
  </div>
</section>

<style>
  .preview {
    max-width: 84rem;
    margin: 0 auto;
    padding: clamp(3rem, 7vw, 5rem) clamp(1rem, 4vw, 2.5rem) 5rem;
    scroll-margin-top: 60px;
  }
  .preview-head {
    text-align: center;
    margin-bottom: 2rem;
  }
  .kicker {
    font-family: var(--font-display);
    font-size: 0.78rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-ficsit);
  }
  .preview-head h2 {
    font-size: clamp(1.9rem, 4vw, 2.75rem);
    margin: 0.5rem 0 0.6rem;
  }
  .preview-head p {
    max-width: 38rem;
    margin: 0 auto;
    color: var(--color-ink-dim);
  }

  .cat {
    margin: 0 0 3rem;
  }
  .cat-h {
    margin: 0 0 1.25rem;
    padding-bottom: 0.7rem;
    border-bottom: 1px solid var(--color-metal);
  }
  .cat-h h3 {
    font-size: 1.4rem;
    margin: 0;
    color: var(--color-ink);
  }
  .cat-h p {
    margin: 0.25rem 0 0;
    font-size: 0.9rem;
    color: var(--color-ink-dim);
  }

  .build {
    margin: 0 0 2rem;
    scroll-margin-top: 120px;
  }
  .build-h {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    margin: 0 0 0.75rem;
  }
  .build-h h4 {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.05rem;
    margin: 0;
    color: var(--color-ink);
  }
  .build-meta {
    font-size: 0.78rem;
    color: var(--color-ink-dim);
  }

  .views {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }
  .card {
    margin: 0;
    width: 232px;
    background: var(--color-panel);
    border: 1px solid var(--color-metal);
    border-radius: 12px;
    overflow: hidden;
    transition:
      transform 0.12s var(--ease-out-quart),
      border-color 0.12s var(--ease-out-quart);
  }
  .card:hover {
    transform: translateY(-2px);
    border-color: color-mix(in srgb, var(--color-ficsit) 55%, var(--color-metal));
  }
  .stage {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 220px;
    padding: 14px;
    border: none;
    cursor: zoom-in;
  }
  .stage img {
    max-height: 190px;
    max-width: 100%;
    width: auto;
    height: auto;
    display: block;
    filter: drop-shadow(0 1px 1px rgba(0, 0, 0, 0.12));
  }
  figcaption {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.5rem 0.75rem;
    border-top: 1px solid var(--color-metal);
    font-size: 0.75rem;
  }
  figcaption .v {
    font-family: var(--font-display);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-ink);
  }
  figcaption .d {
    color: var(--color-ink-dim);
  }
  @media (max-width: 520px) {
    .views {
      gap: 0.75rem;
    }
    .card {
      width: calc(50% - 0.375rem);
    }
    .stage {
      height: 160px;
    }
    .stage img {
      max-height: 132px;
    }
  }
</style>
