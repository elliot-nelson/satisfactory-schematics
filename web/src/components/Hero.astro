---
// Landing hero: the one-line pitch + the big central schematic. Actions live in the top nav now.
import { TAGLINE } from "../lib/site";
import { counts } from "../lib/manifest";
---

<section class="hero" id="top">
  <div class="hero-glow" aria-hidden="true"></div>
  <div class="hero-inner">
    <h1 class="hero-title">{TAGLINE}</h1>

    <div class="hero-figure">
      <div class="hero-figure-frame">
        <img
          src="/docs/excalidraw_foundries_ports.png"
          alt="Orthographic blueprints of foundries with input and output port markers, in Excalidraw blue"
          width="1416"
          height="1074"
          fetchpriority="high"
        />
      </div>
      <div class="hero-stats">
        <span><strong>{counts.buildings}</strong> builds</span>
        <span class="dot"></span>
        <span><strong>{counts.views}</strong> views</span>
        <span class="dot"></span>
        <span><strong>4</strong> themes</span>
        <span class="dot"></span>
        <span><strong>1&thinsp;m = 20&thinsp;px</strong></span>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding: clamp(2.25rem, 5vw, 3.75rem) 1.5rem 4rem;
  }
  .hero-glow {
    position: absolute;
    inset: -20% 0 auto 0;
    height: 70%;
    background: radial-gradient(60% 60% at 50% 0%, rgba(250, 149, 73, 0.16), transparent 70%);
    pointer-events: none;
  }
  .hero-inner {
    position: relative;
    max-width: 60rem;
    margin: 0 auto;
    text-align: center;
  }
  .hero-title {
    max-width: 24ch;
    margin: 0 auto;
    font-size: clamp(2rem, 5vw, 3.5rem);
    line-height: 1.08;
    font-weight: 700;
    letter-spacing: 0.005em;
    text-wrap: balance;
  }
  .hero-figure {
    margin-top: clamp(1.75rem, 4vw, 2.75rem);
  }
  .hero-figure-frame {
    position: relative;
    display: inline-flex;
    padding: clamp(1rem, 3vw, 2rem);
    border-radius: 16px;
    background:
      linear-gradient(180deg, rgba(244, 241, 232, 0.02), transparent),
      var(--color-panel);
    border: 1px solid var(--color-metal);
    box-shadow: 0 30px 80px rgba(0, 0, 0, 0.5);
  }
  .hero-figure-frame::before {
    /* corner-bracket accent */
    content: "";
    position: absolute;
    inset: 10px;
    border: 1px dashed rgba(250, 149, 73, 0.25);
    border-radius: 10px;
    pointer-events: none;
  }
  .hero-figure-frame img {
    display: block;
    width: min(760px, 84vw);
    height: auto;
    filter: drop-shadow(0 6px 18px rgba(0, 0, 0, 0.45));
  }
  .hero-stats {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.65rem;
    margin-top: 1.5rem;
    font-size: 0.9rem;
    color: var(--color-ink-dim);
  }
  .hero-stats strong {
    color: var(--color-ink);
    font-weight: 600;
  }
  .hero-stats .dot {
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--color-ficsit);
    opacity: 0.7;
  }
</style>
