---
// Landing hero: big central schematic, the one-line pitch, and the two CTAs.
import { TAGLINE } from "../lib/site";
import { counts } from "../lib/manifest";
---

<section class="hero" id="top">
  <div class="hero-glow" aria-hidden="true"></div>
  <div class="hero-inner">
    <p class="eyebrow">FICSIT-approved blueprints* &middot; *not really</p>
    <h1 class="hero-title">
      Build it on paper<br />before you <span class="accent">build it for real</span>.
    </h1>
    <p class="hero-tagline">{TAGLINE}</p>

    <div class="hero-cta">
      <a href="#preview" class="btn-ficsit">Browse the preview</a>
      <button type="button" data-download class="btn-ghost">Download a pack</button>
    </div>

    <div class="hero-figure">
      <div class="hero-figure-frame">
        <img
          src="/docs/blender_back.png"
          alt="Orthographic blueprint of a Blender, rear view, in architect blue"
          width="820"
          height="800"
          fetchpriority="high"
        />
      </div>
      <div class="hero-stats">
        <span><strong>{counts.buildings}</strong> builds</span>
        <span class="dot"></span>
        <span><strong>{counts.views}</strong> views</span>
        <span class="dot"></span>
        <span><strong>4</strong> themes</span>
        <span class="dot"></span>
        <span><strong>1&thinsp;m = 20&thinsp;px</strong></span>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding: clamp(3rem, 8vw, 6rem) 1.5rem 4rem;
  }
  .hero-glow {
    position: absolute;
    inset: -20% 0 auto 0;
    height: 70%;
    background: radial-gradient(60% 60% at 50% 0%, rgba(250, 149, 73, 0.16), transparent 70%);
    pointer-events: none;
  }
  .hero-inner {
    position: relative;
    max-width: 60rem;
    margin: 0 auto;
    text-align: center;
  }
  .eyebrow {
    font-family: var(--font-display);
    font-size: 0.8rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-ink-dim);
    margin: 0 0 1.25rem;
  }
  .hero-title {
    font-size: clamp(2.4rem, 6vw, 4.25rem);
    line-height: 1.02;
    font-weight: 700;
    letter-spacing: 0.005em;
    margin: 0;
    text-wrap: balance;
  }
  .hero-title .accent {
    color: var(--color-ficsit);
  }
  .hero-tagline {
    max-width: 40rem;
    margin: 1.5rem auto 0;
    font-size: clamp(1rem, 2.2vw, 1.2rem);
    color: var(--color-ink-dim);
  }
  .hero-cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
    justify-content: center;
    margin-top: 2rem;
  }
  .hero-figure {
    margin-top: clamp(2.5rem, 6vw, 4rem);
  }
  .hero-figure-frame {
    position: relative;
    display: inline-flex;
    padding: clamp(1rem, 3vw, 2rem);
    border-radius: 16px;
    background:
      linear-gradient(180deg, rgba(244, 241, 232, 0.02), transparent),
      var(--color-panel);
    border: 1px solid var(--color-metal);
    box-shadow: 0 30px 80px rgba(0, 0, 0, 0.5);
  }
  .hero-figure-frame::before {
    /* corner-bracket accent */
    content: "";
    position: absolute;
    inset: 10px;
    border: 1px dashed rgba(250, 149, 73, 0.25);
    border-radius: 10px;
    pointer-events: none;
  }
  .hero-figure-frame img {
    display: block;
    width: min(560px, 78vw);
    height: auto;
    filter: drop-shadow(0 6px 18px rgba(0, 0, 0, 0.45));
  }
  .hero-stats {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.65rem;
    margin-top: 1.5rem;
    font-size: 0.9rem;
    color: var(--color-ink-dim);
  }
  .hero-stats strong {
    color: var(--color-ink);
    font-weight: 600;
  }
  .hero-stats .dot {
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--color-ficsit);
    opacity: 0.7;
  }
</style>
