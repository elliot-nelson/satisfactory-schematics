<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>sf-extract</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- We only need mesh geometry then glTF; skip the C++ natives (ACL/Oodle build).
         Oodle decompression is handled at runtime via OodleHelper (download on
         Linux/Windows, or a prebuilt lib passed with the oodle flag). -->
    <CUE4PARSE_SKIP_NATIVE>true</CUE4PARSE_SKIP_NATIVE>
  </PropertyGroup>

  <!-- vendor/ is consumed only via the project reference below; don't compile its
       sources (tests, etc.) into this assembly. -->
  <ItemGroup>
    <Compile Remove="vendor/**/*.cs" />
    <EmbeddedResource Remove="vendor/**" />
    <None Remove="vendor/**" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="vendor/CUE4Parse/CUE4Parse-Conversion/CUE4Parse-Conversion.csproj" />
  </ItemGroup>

</Project>
