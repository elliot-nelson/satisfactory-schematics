<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>sf-extract</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Skip the C++ natives build; Oodle/zlib are provided at runtime (see
         ../../../vendor/cue4parse/README.md). -->
    <CUE4PARSE_SKIP_NATIVE>true</CUE4PARSE_SKIP_NATIVE>
  </PropertyGroup>

  <!-- Our one dependency: the vendored + patched CUE4Parse, hoisted to the repo-level vendor/. -->
  <ItemGroup>
    <ProjectReference Include="../../../vendor/cue4parse/CUE4Parse-Conversion/CUE4Parse-Conversion.csproj" />
  </ItemGroup>

</Project>
